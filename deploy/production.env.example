HALLS_DATA=/var/lib/halls
HALLS_DOWNLOADS=/opt/halls/downloads
HALLS_KEY=/etc/halls/recipient.pem
HALLS_TRUST=/etc/halls/trust.json
HALLS_HOSTS=records.example.com,127.0.0.1
HALLS_ORIGIN=https://records.example.com
HALLS_HTTPS=1
HALLS_TRUST_PROXY=1
HALLS_PROXY_IPS=127.0.0.1,::1
HALLS_STORAGE_GB=10
HALLS_MAX_UPLOAD_MB=15
HALLS_MAX_PLAIN_MB=64
HALLS_MAX_FRAMES=180000
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
