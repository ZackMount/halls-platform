HALLS_API_BASE=https://records.example.com
HALLS_KOH_KEY=replace_with_koh_scope_key
HALLS_CHECK_TIMEOUT=110
HALLS_WEB_UPLOADS=1
HALLS_SUBMISSION_MODE=proof
# NSS 评测服务设置 HALLS_WEB_UPLOADS=0、HALLS_SUBMISSION_MODE=receipt，使用文本提交。
# 反向代理的公开地址（可选）
# HALLS_PUBLIC_ORIGIN=https://example.com
# NSS 题目页面地址（可选）
# HALLS_PROBLEM_URL=https://www.nssctf.cn/team/problem
# 实例标识（可选）
# HALLS_SOURCE_ID=example-instance
# 仅信任代理时启用
# HALLS_TRUST_SOURCE_PROXY=1
